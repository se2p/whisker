{
    "extends": [
        "eslint:recommended",
        "plugin:node/recommended"
    ],
    "plugins": [
        "jest"
    ],
    "parserOptions": {
        "ecmaVersion": "latest"
    },
    "env": {
        "jest": true
    },
    "rules": {
        "no-unpublished-require": "off",
        "no-unused-vars": [
            "error",
            {
                "varsIgnorePattern": "^_",
                "argsIgnorePattern": "^_"
            }
        ],
        "no-constant-condition": [
            "error",
            {
                // We use busy waiting to detect when a Whisker test has finished.
                "checkLoops": false
            }
        ]
    }
}
